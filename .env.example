# Copy to .env (git-ignored) and adjust. Every setting is optional.

# Storage: "memory" (zero infrastructure) or "postgres" (PostgreSQL + pgvector).
CF_STORAGE_BACKEND=postgres
CF_DATABASE_URL=postgresql://contextforge:contextforge@localhost:5432/contextforge
# Memory backend only: persist the index between restarts.
# CF_MEMORY_SNAPSHOT_PATH=.data/index.pkl

# Embeddings: "onnx" (default, all-MiniLM-L6-v2 via ONNX Runtime), "sentence-transformers", or "hashing" (tests only).
CF_EMBEDDING_BACKEND=onnx
# CF_MODEL_DIR=/path/to/all-MiniLM-L6-v2-onnx

# Entity extraction: "auto" (spaCy if installed, else rules), "spacy", or "rules".
CF_ENTITY_EXTRACTOR=auto

# Retrieval weights (alpha = vector, beta = lexical, gamma = entity).
# CF_RETRIEVAL__HYBRID_ENTITY_WEIGHTS='{"vector": 0.4, "lexical": 0.4, "entity": 0.2}'
# CF_RETRIEVAL__CANDIDATE_POOL=30
# CF_CONFIDENCE__THRESHOLD=0.45

# Optional local generation through Ollama (retrieval never depends on it).
# CF_GENERATION__BACKEND=ollama
# CF_GENERATION__OLLAMA_URL=http://localhost:11434
# CF_GENERATION__OLLAMA_MODEL=llama3.2:3b
